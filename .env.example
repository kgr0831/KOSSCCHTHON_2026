# Copy to .env at the repository root. Never commit real values.
# BAT adds missing entries without overwriting existing values.
DUDRI_ENVIRONMENT=development
DUDRI_LOCAL_DEMO_ENABLED=true
# Supabase Dashboard > Connect > Session pooler > URI (port 5432).
# Paste the real URI only into .env. Percent-encode special password characters.
# Empty keeps the existing local SQLite database for offline development.
DUDRI_DATABASE_URL=
DUDRI_AI_API_KEY=
DUDRI_AI_BASE_URL=https://ai.cs.kookmin.ac.kr/v1
# Empty model names select an available Claude / Gemini Flash from /models.
DUDRI_AI_EASY_MODEL=
DUDRI_AI_HARD_MODEL=
DUDRI_AI_TIMEOUT_SECONDS=180
# App/site origins are set to the chosen ports by start-local.bat.
DUDRI_APP_ORIGIN=http://localhost:3000
DUDRI_SITE_ORIGIN=http://127.0.0.1:8001
# Project and storage paths are calculated on each PC; do not copy absolute paths.
# Real email login requires SMTP. Local fictional accounts do not.
DUDRI_SMTP_HOST=
DUDRI_SMTP_PORT=587
DUDRI_SMTP_USERNAME=
DUDRI_SMTP_PASSWORD=
DUDRI_SMTP_SENDER=
DUDRI_SMTP_STARTTLS=true
# Reserved for deployment / future GitHub OAuth; not needed for local demo login.
DUDRI_GITHUB_CLIENT_ID=
DUDRI_GITHUB_CLIENT_SECRET=
DUDRI_CREDENTIAL_ENCRYPTION_KEY=
